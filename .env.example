# Copy to .env.local and fill in. Never commit .env.local.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=german-games
# Google OAuth client (Cloud Console > Credentials). Redirect URI: <origin>/api/auth/callback/google
AUTH_SECRET=generate with: openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AI explanations: set at least one key. Providers are tried in AI_PROVIDERS order; those without a key are skipped.
AI_PROVIDERS=gemini,groq,cerebras
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Optional model overrides (free-tier model lists change often):
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=llama3.1-8b
# Max fresh AI explanations per player per rolling 24h (cached ones are free and uncounted):
AI_CALLS_PER_DAY=5
# Voice answers in the Time game (Deepgram speech-to-text, signed-in players only):
DEEPGRAM_API_KEY=
# Max voice answers per player per rolling 24h:
DEEPGRAM_CALLS_PER_DAY=60
